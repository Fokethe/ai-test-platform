  },

  "executionModes": {
    "modeA": {
      "name": "深度修复模式",
      "description": "单轮彻底修复所有问题",
      "default": true,
      "command": "/bughunter"
    },
    "modeB": {
      "name": "渐进迭代模式",
      "description": "多轮小步快跑，每轮结束询问是否继续",
      "command": "渐进模式启动 BugHunter"
    },
    "modeC": {
      "name": "定向狙击模式",
      "description": "修复特定类型问题",
      "command": "/bughunter --dim={dimension}"
    },
    "modeD": {
      "name": "优先级修复模式",
      "description": "只修复高优先级问题",
      "command": "/bughunter --high"
    },
    "modeE": {
      "name": "全面扫描模式",
      "description": "生成完整问题报告，不自动修复",
      "command": "/bughunter --scan-only"
    }
  },

  "priorityLevels": {
    "high": {
      "symbol": "🔴",
      "description": "影响核心功能，可能导致系统故障",
      "fixDeadline": "上线前必须修复",
      "count": 60
    },
    "medium": {
      "symbol": "🟡",
      "description": "影响使用体验，但不会导致系统故障",
      "fixDeadline": "建议本周修复",
      "count": 100
    },
    "low": {
      "symbol": "🟢",
      "description": "锦上添花，不影响核心功能",
      "fixDeadline": "可规划修复",
      "count": 40
    }
  },

  "integration": {
    "clinerules": {
      "skillId": 9,
      "skillName": "BugHunter",
      "location": ".clinerules",
      "version": "2.0"
    },
    "mcp": {
      "description": "可作为 MCP 工具集成",
      "tools": [
        "scan_codebase",
        "analyze_issues", 
        "apply_fixes",
        "generate_report"
      ]
    }
  }
}
