  "scripts": {
    "test": "jest",
    "test:browser": "jest src/lib/ai/mcp/tools/__tests__/browser.test.ts --no-coverage"
  },
  "type": "module",
  "name": "ai-test-platform",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "lib": "lib"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fokethe/ai-test-platform.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Fokethe/ai-test-platform/issues"
  },
  "homepage": "https://github.com/Fokethe/ai-test-platform#readme",
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "jsdom",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/ai-test-platform/my-app/src/$1"
    },
    "setupFilesAfterEnv": [
      "<rootDir>/ai-test-platform/my-app/jest.setup.js"
    ],
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": "<rootDir>/ai-test-platform/my-app/tsconfig.json",
          "jsx": "react-jsx"
        }
      ]
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(next|@next|react|react-dom)/)"
    ],
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json",
      "node"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/.next/",
      "breadcrumb.test.tsx",
      "/__tests__/route.test.ts",
      "bug-patterns.test.ts",
      "local-embedding.test.ts",
      "storage.test.ts",
      "langfuse-client.test.ts",
      "api-enhanced.test.ts",
      "refactor-ui-navigation.test.tsx",
      "notifications/page.test.tsx",
      "login-page.test.tsx",
      ".kimi/"
    ],
    "extensionsToTreatAsEsm": [
      ".ts",
      ".tsx"
    ]
  }
}
